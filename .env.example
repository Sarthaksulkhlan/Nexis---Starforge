# Matrix Core server configuration.
# Copy this file to .env.local for local development.
# Never commit real credentials.

PORT=3000
APP_URL="http://localhost:3000"

# Gemini reasoning. GOOGLE_API_KEY is preferred; GEMINI_API_KEY is also accepted by the server.
GOOGLE_API_KEY="your_google_api_key"
GEMINI_MODEL="gemini-2.5-flash"

# LiveKit. The browser only receives LIVEKIT_URL and a short-lived access token.
LIVEKIT_URL="wss://your-livekit-host"
LIVEKIT_API_KEY="your_livekit_api_key"
LIVEKIT_API_SECRET="your_livekit_api_secret"

# Rime speech output. Final demo audio should come from Rime, not Gemini audio.
RIME_API_KEY="your_rime_api_key"
RIME_API_URL="https://users.rime.ai/v1/rime-tts"
RIME_MODEL_ID="coda"
RIME_SPEAKER="astra"
RIME_LANGUAGE="en"

# Qdrant contextual memory.
QDRANT_URL="https://your-qdrant-host"
QDRANT_API_KEY="your_qdrant_api_key"
QDRANT_COLLECTION="matrix_core_memory"
